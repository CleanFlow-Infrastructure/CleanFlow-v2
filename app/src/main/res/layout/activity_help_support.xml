<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/app_bg">

    <!-- Top App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_gradient_header"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="20dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_back_arrow"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="16dp"
            android:contentDescription="Back Button"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Help &amp; Community Support"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"/>

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Emergency Dispatch Contact Banner -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_gradient_header"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_water_drop_white"
                            android:layout_marginEnd="12dp"
                            android:contentDescription="Help Icon"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="24/7 Water Emergency Hotline"
                            android:textColor="@color/white"
                            android:textSize="17sp"
                            android:textStyle="bold"/>

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Need immediate assistance for major pipeline bursts or severe contamination? Contact municipal dispatch directly."
                        android:textColor="@color/water_blue_bg"
                        android:textSize="13sp"
                        android:layout_marginBottom="16dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCallHotline"
                            android:layout_width="0dp"
                            android:layout_height="46dp"
                            android:layout_weight="1"
                            android:text="Call 0800 253 263"
                            android:textSize="12.5sp"
                            android:textStyle="bold"
                            app:cornerRadius="12dp"
                            app:backgroundTint="@color/water_blue"
                            android:layout_marginEnd="6dp"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnEmailSupport"
                            android:layout_width="0dp"
                            android:layout_height="46dp"
                            android:layout_weight="1"
                            android:text="Email Support"
                            android:textSize="12.5sp"
                            android:textStyle="bold"
                            app:cornerRadius="12dp"
                            app:backgroundTint="#3B82F6"
                            android:layout_marginStart="6dp"/>

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Section Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="User Guide &amp; System Documentation"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/navy_primary"
                android:layout_marginBottom="12dp"/>

            <!-- Guide Card 1: How to Log a Report -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardGuideReporting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/card_bg"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_water_drop"
                            android:layout_marginEnd="12dp"
                            android:contentDescription="Report Icon"/>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="1. How to Log an Infrastructure Issue"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/navy_primary"/>

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvDetailReporting"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="• Tap 'Report Infrastructure Issue' on Home or the '+' tab in the bottom bar.\n• Choose issue category: Pipe Leak, Borehole, Water Tank, Sanitation, or Pump Station.\n• Select priority severity level (Low, Medium, or High).\n• Capture GPS coordinates or tap 'Use Current Location'.\n• Attach photo evidence of the damage and submit."
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary"
                        android:lineSpacingExtra="4dp"
                        android:layout_marginTop="12dp"/>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Guide Card 2: Tracking Report Statuses -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardGuideStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/card_bg"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_nav_my_reports"
                            android:layout_marginEnd="12dp"
                            android:contentDescription="Status Icon"/>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="2. Tracking &amp; Filter Status Tags"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/navy_primary"/>

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvDetailStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="• Pending (Yellow): Issue successfully logged and waiting in municipal queue.\n• Assigned (Blue): Technical maintenance team dispatched to site.\n• Resolved (Green): Repair completed and water supply verified.\n• Use filter chips on 'My Reports' to sort by status."
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary"
                        android:lineSpacingExtra="4dp"
                        android:layout_marginTop="12dp"/>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Guide Card 3: Pump & Reservoir Telemetry -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardGuideTelemetry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/card_bg"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_water_drop"
                            android:layout_marginEnd="12dp"
                            android:contentDescription="Telemetry Icon"/>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="3. Interactive System Telemetry"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/navy_primary"/>

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvDetailTelemetry"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="• Tap 'Pump Stations' on Home to check active pump health &amp; run diagnostics.\n• Tap 'Reservoir Level' to check water capacity, pH purity tests, and estimated remaining supply."
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary"
                        android:lineSpacingExtra="4dp"
                        android:layout_marginTop="12dp"/>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Guide Card 4: Account & SSO Security -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardGuideAccount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/card_bg"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_nav_profile"
                            android:layout_marginEnd="12dp"
                            android:contentDescription="Account Icon"/>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="4. Account &amp; Password Recovery"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/navy_primary"/>

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvDetailAccount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="• Sign in securely using Google SSO or email credentials.\n• Update personal contact details in Profile settings.\n• Lost password? Tap 'Forgot Password?' on the Login screen to receive a reset link."
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary"
                        android:lineSpacingExtra="4dp"
                        android:layout_marginTop="12dp"/>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </ScrollView>

</LinearLayout>