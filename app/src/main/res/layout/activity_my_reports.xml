<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/app_bg">

    <!-- Unified Top Header with Embedded KPI Summary -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_gradient_header"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="20dp">

        <!-- Title Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_back_arrow"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginEnd="16dp"
                android:contentDescription="Back Button"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="My Community Reports"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"/>

        </LinearLayout>

        <!-- KPI Metrics Bar inside Top Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/badge_assigned"
            android:backgroundTint="#1B2F52"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <!-- Total -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvTotalCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TOTAL"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/water_blue_bg"/>

            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="24dp"
                android:layout_gravity="center_vertical"
                android:background="#33FFFFFF"/>

            <!-- Pending -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvPendingCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#FBBF24"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PENDING"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/water_blue_bg"/>

            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="24dp"
                android:layout_gravity="center_vertical"
                android:background="#33FFFFFF"/>

            <!-- Resolved -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvResolvedCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#34D399"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RESOLVED"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/water_blue_bg"/>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- Floating Filter Chips Row -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/app_bg"
        android:scrollbars="none"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFilterAll"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="All"
                android:textSize="12.5sp"
                android:textStyle="bold"
                app:cornerRadius="20dp"
                app:backgroundTint="@color/navy_primary"
                android:textColor="@color/white"
                android:layout_marginEnd="8dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFilterPending"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="Pending"
                android:textSize="12.5sp"
                android:textStyle="bold"
                app:cornerRadius="20dp"
                app:backgroundTint="@color/card_stroke"
                android:textColor="@color/text_secondary"
                android:layout_marginEnd="8dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFilterAssigned"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="Assigned"
                android:textSize="12.5sp"
                android:textStyle="bold"
                app:cornerRadius="20dp"
                app:backgroundTint="@color/card_stroke"
                android:textColor="@color/text_secondary"
                android:layout_marginEnd="8dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFilterResolved"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="Resolved"
                android:textSize="12.5sp"
                android:textStyle="bold"
                app:cornerRadius="20dp"
                app:backgroundTint="@color/card_stroke"
                android:textColor="@color/text_secondary"/>

        </LinearLayout>
    </HorizontalScrollView>

    <!-- Reports Count -->
    <TextView
        android:id="@+id/tvReportCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Loading reports..."
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/text_muted"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="10dp"
        android:paddingBottom="6dp"/>

    <!-- Reports List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMyReports"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="8dp"
        android:clipToPadding="false"/>

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/layoutEmpty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_water_drop"
            android:alpha="0.4"
            android:contentDescription="Empty state icon"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No Reports Found"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/navy_primary"
            android:layout_marginTop="14dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="You haven't submitted any water or sanitation reports under this filter yet."
            android:textSize="13sp"
            android:textColor="@color/text_muted"
            android:gravity="center"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCreateReport"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Log New Water Report"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            app:backgroundTint="@color/navy_primary"/>

    </LinearLayout>

</LinearLayout>